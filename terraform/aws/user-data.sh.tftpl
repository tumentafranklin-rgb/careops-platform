#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/careops-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

aws --version

aws ecr get-login-password --region us-east-1 \
  | docker login --username AWS --password-stdin \
    126309364316.dkr.ecr.us-east-1.amazonaws.com

docker pull "${repository_url}:v3"

docker run -d \
  --name careops-app \
  --restart unless-stopped \
  --log-opt max-size=10m \
  --log-opt max-file=3 \
  -p 5000:5000 \
  "${repository_url}:v3"

docker logout 126309364316.dkr.ecr.us-east-1.amazonaws.com